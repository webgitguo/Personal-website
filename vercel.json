{
  "version": 2,
  "name": "react-framework",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
  
    {
      "src": "/(.*\\.(js|css|svg|png|jpg|jpeg|gif|ico|woff|woff2|ttf|eot|webp))$",
      "dest": "/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },

    {
      "src": "/[^.]+",
      "dest": "/index.html",
      "status": 200
    },
 
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}